# Copy to .env.local and fill in. Without this the web app falls back to the
# shared public devnet endpoint, which is rate-limited and breaks on-chain trades.
NEXT_PUBLIC_SOLANA_RPC_URL=

# Postgres (Neon) for resolution specs. Required on Vercel (read-only
# filesystem); when unset locally, specs go to apps/resolver/data/specs.
# Apply migrations with: DATABASE_URL=… pnpm --filter @mention/db migrate
DATABASE_URL=
